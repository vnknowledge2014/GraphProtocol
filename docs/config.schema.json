{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GapConfig",
  "description": "Root `gap.toml` configuration (`spec/00-conventions.md` §8).",
  "type": "object",
  "properties": {
    "api_keys": {
      "description": "API keys the gateway accepts, as `blake3` digests (`[[api_keys]]`, `SEC-001`).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ApiKeySpec"
      }
    },
    "auth": {
      "description": "Authentication settings.",
      "$ref": "#/$defs/AuthConfig",
      "default": {
        "allow_anonymous": false,
        "clock_skew_secs": 60
      }
    },
    "branches": {
      "description": "Branch inventory the gateway is assembled from (`[[branches]]`).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/BranchSpec"
      }
    },
    "gateway": {
      "description": "Gateway routing, tenant, and facade posture.",
      "$ref": "#/$defs/GatewayConfig",
      "default": {
        "default_tenant": "default",
        "facade_spotlight": true,
        "max_hops": 4
      }
    },
    "limits": {
      "description": "Complexity, depth, payload, and deadline limits.",
      "$ref": "#/$defs/LimitsConfig",
      "default": {
        "default_list_size": 100,
        "max_aliases": 50,
        "max_branches": 1000,
        "max_cost_units": 10000,
        "max_request_body_bytes": 1048576,
        "max_response_body_bytes": 4194304,
        "max_root_fields": 20,
        "max_selection_depth": 12,
        "max_variables": 100,
        "request_deadline_ms": 30000,
        "traverse_max_depth": 16
      }
    },
    "profile": {
      "description": "Active deployment profile (`dev` or `prod`).",
      "$ref": "#/$defs/Profile",
      "default": "prod"
    },
    "router": {
      "description": "Discovery System-1 decision router configuration (`ADR-028`, `INV-17`).",
      "$ref": "#/$defs/RouterSectionConfig",
      "default": {
        "provider": "disabled",
        "timeout_ms": 400
      }
    },
    "security": {
      "description": "Policy, approval, and sandbox settings.",
      "$ref": "#/$defs/SecurityConfig",
      "default": {
        "allow_unsandboxed": false,
        "four_eyes_approval": true,
        "policy_dir": "policies"
      }
    },
    "server": {
      "description": "Listener and shutdown configuration.",
      "$ref": "#/$defs/ServerConfig",
      "default": {
        "admin_listen": "127.0.0.1:9090",
        "grpc_listen": "127.0.0.1:8081",
        "listen": "127.0.0.1:8080",
        "shutdown_grace_ms": 30000,
        "tls_self_signed_dev": false
      }
    },
    "storage": {
      "description": "Persistence and bounded blocking pool settings.",
      "$ref": "#/$defs/StorageConfig",
      "default": {
        "blob_dir": ".gap/blobs",
        "blocking_pool_threads": 4,
        "blocking_queue_capacity": 128,
        "sqlite_path": ".gap/state.db"
      }
    },
    "telemetry": {
      "description": "Structured logging and OpenTelemetry settings.",
      "$ref": "#/$defs/TelemetryConfig",
      "default": {
        "head_sample_ratio": 0.1,
        "log_json": true,
        "log_level": "info",
        "service_name": "gap-server",
        "slow_ms": 500
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ApiKeySpec": {
      "description": "One `[[api_keys]]` entry: the `blake3` digest of a key, never the key (`INV-15`).",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable non-secret identifier (becomes the principal id).",
          "type": "string"
        },
        "key_hash": {
          "description": "64 hex characters: `blake3-256` of the raw key.",
          "type": "string"
        },
        "scopes": {
          "description": "Authorization scopes granted to the key.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "tenant": {
          "description": "Tenant the key is bound to (`SEC-010`); the default tenant when absent.",
          "$ref": "#/$defs/TenantId",
          "default": "default"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "key_hash"
      ]
    },
    "AuthConfig": {
      "description": "`[auth]` OAuth 2.1 / mTLS / API-key settings (`SEC-001`, `SEC-002`, `INV-15`).",
      "type": "object",
      "properties": {
        "allow_anonymous": {
          "description": "Allow unauthenticated callers (`SEC-002`: permitted ONLY when `profile = \"dev\"`).",
          "type": "boolean",
          "default": false
        },
        "audience": {
          "description": "Expected resource indicator / audience (`aud`, RFC 8707).",
          "type": [
            "string",
            "null"
          ]
        },
        "clock_skew_secs": {
          "description": "Allowed JWT clock skew in seconds (`0..=60`, default `60`, `SEC-001`).",
          "type": "integer",
          "format": "uint32",
          "default": 60,
          "minimum": 0
        },
        "introspection_client_secret": {
          "description": "Optional RFC 7662 introspection client secret reference (`INV-15`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "description": "Expected OAuth 2.1 token issuer (`iss`).",
          "type": [
            "string",
            "null"
          ]
        },
        "jwks_uri": {
          "description": "Remote JWKS endpoint URL.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "BranchAuthKind": {
      "description": "How a branch authenticates to its upstream.",
      "oneOf": [
        {
          "description": "No upstream credentials.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "`Authorization: Bearer <secret>`.",
          "type": "string",
          "const": "bearer"
        },
        {
          "description": "An API key sent in the header or query parameter named by `name`.",
          "type": "string",
          "const": "api_key"
        }
      ]
    },
    "BranchAuthSpec": {
      "description": "Upstream authentication of a branch; the credential is only ever a [`SecretRef`] (`INV-15`).",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Authentication scheme.",
          "$ref": "#/$defs/BranchAuthKind",
          "default": "none"
        },
        "name": {
          "description": "Header or query-parameter name for [`BranchAuthKind::ApiKey`].",
          "type": [
            "string",
            "null"
          ]
        },
        "secret": {
          "description": "Reference to the credential (`env://NAME`, `file:///abs/path`, `secret://vault/name`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "BranchId": {
      "type": "string",
      "maxLength": 63,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_-]{1,62}$"
    },
    "BranchProtocol": {
      "description": "Wire protocol of a configured branch.",
      "oneOf": [
        {
          "description": "An OpenAPI 3.x REST service (`gap-ngc-openapi`).",
          "type": "string",
          "const": "openapi"
        },
        {
          "description": "A Model Context Protocol server (`gap-mcp` outbound).",
          "type": "string",
          "const": "mcp"
        }
      ]
    },
    "BranchSpec": {
      "description": "One `[[branches]]` entry.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique branch slug.",
          "$ref": "#/$defs/BranchId"
        },
        "mcp": {
          "description": "MCP settings (`protocol = \"mcp\"`).",
          "anyOf": [
            {
              "$ref": "#/$defs/McpBranchSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "openapi": {
          "description": "OpenAPI settings (`protocol = \"openapi\"`).",
          "anyOf": [
            {
              "$ref": "#/$defs/OpenApiBranchSpec"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol": {
          "description": "Wire protocol; selects which of `openapi` / `mcp` must be present.",
          "$ref": "#/$defs/BranchProtocol"
        },
        "trust": {
          "description": "Trust tier (`ADR-013`); `T1` when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/TrustTier"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "description": "Explicit stable branch UUIDv7; derived from `id` when absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/BranchUid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "protocol"
      ]
    },
    "BranchUid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "GatewayConfig": {
      "description": "`[gateway]` tenant, operation-mode, and facade settings (`ADR-018`, `GQL-060`, `INV-20`, `SEC-083`).",
      "type": "object",
      "properties": {
        "default_tenant": {
          "description": "Default tenant slug when running single-tenant (`ADR-018`).",
          "$ref": "#/$defs/TenantId",
          "default": "default"
        },
        "facade_spotlight": {
          "description": "Wrap `T2` branch results in `<gap:untrusted>` spotlighting tags (`SEC-083`, default `true`).",
          "type": "boolean",
          "default": true
        },
        "max_hops": {
          "description": "Maximum peer-to-peer forwarding hops (`INV-20`, default `4`, range `1..=16`).",
          "type": "integer",
          "format": "uint8",
          "default": 4,
          "maximum": 255,
          "minimum": 0
        },
        "operation_mode": {
          "description": "Explicit operation mode override; defaults to `open` (`dev`) or `hybrid` (`prod`) (`GQL-060`).",
          "anyOf": [
            {
              "$ref": "#/$defs/OperationMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "LimitsConfig": {
      "description": "`[limits]` query complexity, depth, size, and deadline caps (`spec/02-gap-ql.md` §8, `OPS-020`).",
      "type": "object",
      "properties": {
        "default_list_size": {
          "description": "Default list multiplier when caller omits `first`/`limit` (`1..=1_000`, default `100`).",
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        },
        "max_aliases": {
          "description": "Max aliases per document (`1..=500`, default `50`).",
          "type": "integer",
          "format": "uint32",
          "default": 50,
          "minimum": 0
        },
        "max_branches": {
          "description": "Max registered branches for bounded metric cardinality (`1..=10_000`, default `1_000`, `OPS-020`).",
          "type": "integer",
          "format": "uint32",
          "default": 1000,
          "minimum": 0
        },
        "max_cost_units": {
          "description": "Max planned cost units (`100..=1_000_000`, default `10_000`).",
          "type": "integer",
          "format": "uint32",
          "default": 10000,
          "minimum": 0
        },
        "max_request_body_bytes": {
          "description": "Max HTTP/gRPC request body in bytes (`16_384..=16_777_216`, default `1_048_576`).",
          "type": "integer",
          "format": "uint64",
          "default": 1048576,
          "minimum": 0
        },
        "max_response_body_bytes": {
          "description": "Max serialized response body in bytes (`65_536..=67_108_864`, default `4_194_304`).",
          "type": "integer",
          "format": "uint64",
          "default": 4194304,
          "minimum": 0
        },
        "max_root_fields": {
          "description": "Max root fields (`1..=100`, default `20`).",
          "type": "integer",
          "format": "uint32",
          "default": 20,
          "minimum": 0
        },
        "max_selection_depth": {
          "description": "Max selection depth (`1..=32`, default `12`).",
          "type": "integer",
          "format": "uint32",
          "default": 12,
          "minimum": 0
        },
        "max_variables": {
          "description": "Max variables per document (`1..=1_000`, default `100`).",
          "type": "integer",
          "format": "uint32",
          "default": 100,
          "minimum": 0
        },
        "request_deadline_ms": {
          "description": "Max request deadline in milliseconds (`100..=600_000`, default `30_000`).",
          "type": "integer",
          "format": "uint64",
          "default": 30000,
          "minimum": 0
        },
        "traverse_max_depth": {
          "description": "Hard cap on `traverse.maxDepth` (`1..=16`, default `16`, `GQL-040`).",
          "type": "integer",
          "format": "uint8",
          "default": 16,
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "McpBranchSpec": {
      "description": "`[branches.mcp]`: an MCP server upstream.",
      "type": "object",
      "properties": {
        "allow_insecure": {
          "description": "Permit cleartext `http://` to a non-loopback host.",
          "type": "boolean",
          "default": false
        },
        "args": {
          "description": "Arguments of the child process.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auth": {
          "description": "Upstream authentication (HTTP only).",
          "$ref": "#/$defs/BranchAuthSpec",
          "default": {
            "kind": "none"
          }
        },
        "command": {
          "description": "Absolute executable path for [`McpTransportKind::Stdio`].",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "description": "Pinned `sha256` (64 hex characters) of the executable; required for stdio.",
          "type": [
            "string",
            "null"
          ]
        },
        "transport": {
          "description": "Transport.",
          "$ref": "#/$defs/McpTransportKind"
        },
        "url": {
          "description": "Endpoint for [`McpTransportKind::Http`].",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "transport"
      ]
    },
    "McpTransportKind": {
      "description": "Transport of an MCP branch.",
      "oneOf": [
        {
          "description": "Streamable HTTP at `url`.",
          "type": "string",
          "const": "http"
        },
        {
          "description": "A child process speaking newline-delimited JSON-RPC (allow-listed, hash-pinned).",
          "type": "string",
          "const": "stdio"
        }
      ]
    },
    "OpenApiBranchSpec": {
      "description": "`[branches.openapi]`: an OpenAPI 3.x REST upstream.",
      "type": "object",
      "properties": {
        "allow_insecure_upstream": {
          "description": "Permit cleartext `http://` credentials to a non-loopback host.",
          "type": "boolean",
          "default": false
        },
        "auth": {
          "description": "Upstream authentication.",
          "$ref": "#/$defs/BranchAuthSpec",
          "default": {
            "kind": "none"
          }
        },
        "base_url": {
          "description": "Upstream origin and optional base path (`http://` or `https://`).",
          "type": "string"
        },
        "max_in_flight": {
          "description": "Connector-enforced concurrent in-flight RPC cap (`>= 1`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "max_page_size": {
          "description": "Largest page the connector advertises (`>= 1`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "spec": {
          "description": "OpenAPI document path, relative to the directory of `gap.toml` (no `..`, not absolute).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "spec",
        "base_url"
      ]
    },
    "OperationMode": {
      "description": "Gateway document allow-listing mode (`GQL-060`).",
      "oneOf": [
        {
          "description": "Arbitrary queries and mutations permitted (default in `dev`).",
          "type": "string",
          "const": "open"
        },
        {
          "description": "Arbitrary read queries permitted; mutations/tasks require persisted operations (default in `prod`).",
          "type": "string",
          "const": "hybrid"
        },
        {
          "description": "Only registered persisted operations permitted.",
          "type": "string",
          "const": "safelist"
        }
      ]
    },
    "Profile": {
      "description": "Deployment profile (`OPS-001`).",
      "oneOf": [
        {
          "description": "Local development profile (`operation_mode` defaults to `open`, anonymous allowed if enabled).",
          "type": "string",
          "const": "dev"
        },
        {
          "description": "Production profile (`operation_mode` defaults to `hybrid`, anonymous forbidden, `OPS-001`).",
          "type": "string",
          "const": "prod"
        }
      ]
    },
    "RouterProviderConfig": {
      "description": "Optional System-1 decision model provider configured under `[router]` (`ADR-028`, `RTE-047`..`049`).",
      "oneOf": [
        {
          "description": "Default deterministic BM25+HNSW baseline router (`BASELINE_FALLBACK`, `INV-17`).",
          "type": "string",
          "const": "disabled"
        },
        {
          "description": "Built-in Candle ModernBERT System-1 backend (`LayaCandle`).",
          "type": "string",
          "const": "laya_candle"
        },
        {
          "description": "ONNX Runtime System-1 backend (`LayaOrt`, requires `--features s1-ort`).",
          "type": "string",
          "const": "laya_ort"
        },
        {
          "description": "Generic `/v1/systemone` HTTP sidecar (`omni decide --endpoint`).",
          "type": "string",
          "const": "http_sidecar"
        },
        {
          "description": "`@receptron/laya` ONNX HTTP bridge (`github.com/receptron/laya`).",
          "type": "string",
          "const": "receptron_laya"
        },
        {
          "description": "TypeSafe AI `Jev` (`POST /v1/systemone`).",
          "type": "string",
          "const": "jev"
        },
        {
          "description": "Google `Gemini Decision 1` (`POST /v1beta/decisions`).",
          "type": "string",
          "const": "gemini_decision_1"
        }
      ]
    },
    "RouterSectionConfig": {
      "description": "Optional discovery-plane router configuration (`[router]`, `RTE-044`, `RTE-049`, `INV-17`).",
      "type": "object",
      "properties": {
        "api_key_secret": {
          "description": "Optional secret reference for provider API key (`env://...` or `file://...`, `INV-15`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoint": {
          "description": "Optional provider base or full endpoint URL (`http://127.0.0.1:4000` or proxy).",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Optional provider model override (e.g. `jev-latest`, `gemini-decision-1`, `convaiinnovations/laya`).",
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "description": "Selected System-1 decision provider (`disabled` by default per `G-S1` / `INV-17`).",
          "$ref": "#/$defs/RouterProviderConfig",
          "default": "disabled"
        },
        "timeout_ms": {
          "description": "Per-call S1 inference preemption budget in milliseconds (`RTE-044`, default `400`).",
          "type": "integer",
          "format": "uint64",
          "default": 400,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "SecretRef": {
      "description": "External secret reference (`secret://<vault>/<name>`, `env://<VAR>`, or `file:///<abs-path>`). Inline secrets are forbidden (INV-15).",
      "type": "string",
      "pattern": "^(secret://[A-Za-z0-9._-]+/[^\\s]+|env://[A-Z_][A-Z0-9_]*|file:///[^\\s]+)$"
    },
    "SecurityConfig": {
      "description": "`[security]` Cedar policy, four-eyes approval, and process-sandbox settings (`SEC-020`, `SEC-071`, `RUN-071`).",
      "type": "object",
      "properties": {
        "allow_unsandboxed": {
          "description": "Permit `T1` process connectors when OS sandbox is unavailable (`SEC-071`; `T2` always fails closed).",
          "type": "boolean",
          "default": false
        },
        "approval_signing_key_secret": {
          "description": "Gateway signing key reference for `ApprovalProof` (`NGC-032`, `INV-15`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "four_eyes_approval": {
          "description": "Require approver principal != requester principal (`RUN-071`).",
          "type": "boolean",
          "default": true
        },
        "policy_dir": {
          "description": "Directory containing `*.cedar` policies and `schema.cedarschema` (`SEC-020`).",
          "type": "string",
          "default": "policies"
        }
      },
      "additionalProperties": false
    },
    "ServerConfig": {
      "description": "`[server]` listener and graceful-shutdown settings (`OPS-002`, `OPS-005`, `RUN-090`).",
      "type": "object",
      "properties": {
        "admin_listen": {
          "description": "Separate authenticated `/admin/*` listener (`OPS-002`).",
          "type": "string",
          "default": "127.0.0.1:9090"
        },
        "grpc_listen": {
          "description": "Dedicated gRPC Gateway listener (`OPS-002`).",
          "type": "string",
          "default": "127.0.0.1:8081"
        },
        "http3_listen": {
          "description": "Optional dual-stack HTTP/3 over QUIC (`RFC 9114`, UDP) bind address (`OPS-005`, `ADR-026`).",
          "type": [
            "string",
            "null"
          ]
        },
        "listen": {
          "description": "Primary HTTP/1.1 + HTTP/2 (TCP) GraphQL, SSE, MCP, and A2A bind address (`OPS-002`).",
          "type": "string",
          "default": "127.0.0.1:8080"
        },
        "shutdown_grace_ms": {
          "description": "Graceful drain window on `SIGTERM` in milliseconds (`RUN-090`, default `30_000`).",
          "type": "integer",
          "format": "uint64",
          "default": 30000,
          "minimum": 0
        },
        "tls_cert_secret": {
          "description": "Optional TLS certificate reference (`file:///...`, `env://...`, or `secret://...`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls_key_secret": {
          "description": "Optional TLS private key reference (`file:///...`, `env://...`, or `secret://...`, `INV-15`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "tls_self_signed_dev": {
          "description": "Permits ephemeral self-signed TLS 1.3 cert generation strictly in `profile = \"dev\"` (`OPS-005`).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "StorageConfig": {
      "description": "`[storage]` state store, blob store, and bounded blocking-pool settings (`OPS-003`, `ARC-010`, `ARC-011`).",
      "type": "object",
      "properties": {
        "blob_dir": {
          "description": "Local artifact blob directory (`RUN-086`).",
          "type": "string",
          "default": ".gap/blobs"
        },
        "blocking_pool_threads": {
          "description": "Worker thread count for dedicated CPU/blocking pool (`1..=256`, default `4`, `ARC-010`).",
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "blocking_queue_capacity": {
          "description": "Bounded blocking-pool queue capacity (`1..=65_536`, default `128`, `ARC-010`, `ARC-011`).",
          "type": "integer",
          "format": "uint",
          "default": 128,
          "minimum": 0
        },
        "sqlite_path": {
          "description": "Local SQLite database path (`OPS-003`).",
          "type": "string",
          "default": ".gap/state.db"
        }
      },
      "additionalProperties": false
    },
    "TelemetryConfig": {
      "description": "`[telemetry]` structured logging and OpenTelemetry settings (`OPS-010`, `spec/08-operations.md` §§2, 4).",
      "type": "object",
      "properties": {
        "head_sample_ratio": {
          "description": "Parent-based head sampling ratio (`0.0..=1.0`, default `0.10`, `OPS-010`).",
          "type": "number",
          "format": "double",
          "default": 0.1
        },
        "log_json": {
          "description": "Emit structured JSON logs (`true` by default, `spec/08-operations.md` §4).",
          "type": "boolean",
          "default": true
        },
        "log_level": {
          "description": "`tracing-subscriber` `EnvFilter` directive string (default `\"info\"`).",
          "type": "string",
          "default": "info"
        },
        "otlp_auth_header_secret": {
          "description": "Optional OTLP authorization header secret reference (`INV-15`).",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "otlp_endpoint": {
          "description": "Optional OTLP gRPC collector endpoint (e.g. `\"http://127.0.0.1:4317\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "service_name": {
          "description": "OpenTelemetry `service.name` resource attribute.",
          "type": "string",
          "default": "gap-server"
        },
        "slow_ms": {
          "description": "Slow-request threshold in milliseconds (`OPS-010`, default `500`).",
          "type": "integer",
          "format": "uint64",
          "default": 500,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "TenantId": {
      "type": "string",
      "maxLength": 63,
      "minLength": 2,
      "pattern": "^[a-z][a-z0-9_-]{1,62}$"
    },
    "TrustTier": {
      "description": "Branch trust tier (`ADR-013`, `spec/07-security.md` §8).",
      "oneOf": [
        {
          "description": "Organization-signed manifest (`SEC-060`).",
          "type": "string",
          "const": "T0"
        },
        {
          "description": "Admin-approved with pinned hashes (`SEC-061`).",
          "type": "string",
          "const": "T1"
        },
        {
          "description": "Untrusted / discovered / drifted (`SEC-061`, `INV-07`).",
          "type": "string",
          "const": "T2"
        }
      ]
    }
  }
}
