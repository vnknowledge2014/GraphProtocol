{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping GAP /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "GAP Routing, Conformal Discovery, System-1 Calibration (ECE), Branch EWMA, and Circuit Breakers (spec/04-discovery-and-routing.md, spec/08-operations.md).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Discovery Decisions by Outcome and Model",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (outcome, model) (rate(gap_discovery_decisions_total[5m]))",
          "legendFormat": "{{model}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 0.25 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "System-1 Online ECE (Alert Threshold = 0.05)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gap_s1_online_ece",
          "legendFormat": "online_ece",
          "refId": "A"
        },
        {
          "expr": "vector(0.05)",
          "legendFormat": "ECE threshold (0.05)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Conformal Discovery Set Size Quantiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gap_discovery_set_size_bucket[5m])))",
          "legendFormat": "p50 |C(x)|",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gap_discovery_set_size_bucket[5m])))",
          "legendFormat": "p95 |C(x)|",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "S1 Inference Duration by Backend",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(gap_s1_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{backend}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, backend) (rate(gap_s1_inference_duration_seconds_bucket[5m])))",
          "legendFormat": "{{backend}} p99",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Router Fallbacks by Reason",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (rate(gap_router_fallback_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "title": "Branch Circuit Breaker State (0=Closed, 1=HalfOpen, 2=Open)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gap_breaker_state{branch=~\"$branch\"}",
          "legendFormat": "{{branch}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "title": "Branch Error EWMA & Retry Exhaustion",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gap_branch_error_ewma{branch=~\"$branch\"}",
          "legendFormat": "err_ewma {{branch}}",
          "refId": "A"
        },
        {
          "expr": "rate(gap_retry_budget_exhausted_total{branch=~\"$branch\"}[5m])",
          "legendFormat": "retry_exhausted {{branch}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["gap", "routing", "s1"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "name": "branch",
        "options": [],
        "query": "label_values(gap_breaker_state, branch)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "utc",
  "title": "GAP — Discovery Routing & System-1",
  "uid": "gap-routing-s1",
  "version": 1
}
