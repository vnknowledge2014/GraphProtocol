{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping GAP /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "GAP Security Policy, Hash-Chained Audit Integrity, Ingestion Pipeline, Durable Tasks, and Response Token Budget (spec/06-security.md, spec/05-ingestion-and-context.md).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cedar Policy Decisions by Action & Effect",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (action, effect) (rate(gap_policy_decisions_total[5m]))",
          "legendFormat": "{{action}} -> {{effect}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Audit Hash-Chain Head Sequence & Verify Failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gap_audit_chain_head_seq",
          "legendFormat": "head_seq ({{chain}})",
          "refId": "A"
        },
        {
          "expr": "increase(gap_audit_verify_failures_total[15m])",
          "legendFormat": "verify_failures ({{chain}})",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Ingestion Backlog & Validation Gate Failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gap_ingest_backlog",
          "legendFormat": "ingest_backlog",
          "refId": "A"
        },
        {
          "expr": "sum by (gate) (rate(gap_ingest_gate_failures_total[5m]))",
          "legendFormat": "gate_fail ({{gate}})",
          "refId": "B"
        },
        {
          "expr": "rate(gap_unmapped_events_dropped_total[5m])",
          "legendFormat": "unmapped_events_dropped/s",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Durable Tasks Active & State Transitions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gap_tasks_active",
          "legendFormat": "tasks_active",
          "refId": "A"
        },
        {
          "expr": "sum by (state) (rate(gap_task_state_total[5m]))",
          "legendFormat": "state={{state}}/s",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "title": "Response Tokens Returned by Facade Tool / Operation Class",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (tool) (rate(gap_tokens_returned_total[5m]))",
          "legendFormat": "{{tool}} tokens/s",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["gap", "security", "ingest", "tasks"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "utc",
  "title": "GAP — Security, Ingestion & Durable Tasks",
  "uid": "gap-security-ingest",
  "version": 1
}
