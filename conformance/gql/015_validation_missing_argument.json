{
  "name": "a missing required argument is named in missingArguments",
  "class": [
    "Core"
  ],
  "spec": [
    "GQL-002",
    "GQL-070"
  ],
  "schema": "fixtures/shop.graphql",
  "request": {
    "query": "{ order { id } }"
  },
  "expect": {
    "status": 422,
    "dataNull": true,
    "headers": {
      "content-type": "application/graphql-response+json; charset=utf-8"
    },
    "errors": [
      {
        "extensions": {
          "code": "GAP_MISSING_ARGUMENT",
          "suggestion": {
            "missingArguments": [
              "id"
            ]
          }
        }
      }
    ]
  }
}
