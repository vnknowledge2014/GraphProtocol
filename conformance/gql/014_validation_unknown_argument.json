{
  "name": "an unknown argument is rejected",
  "class": [
    "Core"
  ],
  "spec": [
    "GQL-002"
  ],
  "schema": "fixtures/shop.graphql",
  "request": {
    "query": "{ order(id: \"1\", limit: 3) { id } }"
  },
  "expect": {
    "status": 422,
    "dataNull": true,
    "headers": {
      "content-type": "application/graphql-response+json; charset=utf-8"
    },
    "errors": [
      {
        "extensions": {
          "code": "GAP_UNKNOWN_ARGUMENT"
        }
      }
    ]
  }
}
