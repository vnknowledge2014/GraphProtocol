{
  "name": "an unknown field below a field suggests the sibling field",
  "class": [
    "Core"
  ],
  "spec": [
    "GQL-002",
    "GQL-070"
  ],
  "schema": "fixtures/shop.graphql",
  "request": {
    "query": "{ order(id: \"1\") { idd } }"
  },
  "expect": {
    "status": 422,
    "dataNull": true,
    "headers": {
      "content-type": "application/graphql-response+json; charset=utf-8"
    },
    "errors": [
      {
        "extensions": {
          "code": "GAP_UNKNOWN_FIELD",
          "suggestion": {
            "didYouMean": [
              "id"
            ]
          }
        }
      }
    ]
  }
}
