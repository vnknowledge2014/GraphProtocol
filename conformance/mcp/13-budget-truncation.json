{
  "name": "budget.tokens truncates compact text rendering with truncation marker while keeping structuredContent intact",
  "class": ["Facade-MCP"],
  "spec": ["CMP-004", "GQL-022"],
  "setup": {
    "snapshot": "two-branch",
    "principal": {
      "subject": "user:alice",
      "tenant": "acme-corp",
      "scopes": ["read:all"]
    }
  },
  "steps": [
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "gap_query",
            "arguments": {
              "query": "{ billing_invoice(id: \"inv-long-identifier-123456\") { id total } }",
              "budget": {
                "tokens": 6
              }
            },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "resultType": "complete",
            "isError": false,
            "structuredContent": {
              "data": {
                "billing_invoice": {
                  "id": "inv-long-identifier-123456",
                  "total": 4200
                }
              }
            }
          }
        }
      }
    }
  ]
}
