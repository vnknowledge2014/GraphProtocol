{
  "name": "gap_query executes read-only GAP-QL and rejects mutations before execution with GAP_OPERATION_NOT_ALLOWED",
  "class": ["Facade-MCP"],
  "spec": ["CMP-002", "CMP-004"],
  "setup": {
    "snapshot": "two-branch",
    "principal": {
      "subject": "user:alice",
      "tenant": "acme-corp",
      "scopes": ["read:all"]
    }
  },
  "steps": [
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "gap_query",
            "arguments": {
              "query": "{ billing_invoice(id: \"inv-1\") { id total } }"
            },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "resultType": "complete",
            "isError": false,
            "structuredContent": {
              "data": {
                "billing_invoice": {
                  "id": "inv-1",
                  "total": 4200
                }
              }
            }
          }
        }
      }
    },
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/call",
          "params": {
            "name": "gap_query",
            "arguments": {
              "query": "mutation { billing_createInvoice(amount: 100) { id } }"
            },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "result": {
            "resultType": "complete",
            "isError": true,
            "structuredContent": {
              "errors": [
                {
                  "extensions": {
                    "code": "GAP_OPERATION_NOT_ALLOWED"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "tools/call",
          "params": {
            "name": "gap_query",
            "arguments": {
              "query": "{ billing_invoice(id: \"inv-1\") { id } }",
              "extra": true
            },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": 3,
          "error": {
            "code": -32602
          }
        }
      }
    }
  ]
}
