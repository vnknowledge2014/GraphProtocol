{
  "name": "gap_task decide succeeds when principal carries tasks:decide scope",
  "class": ["Facade-MCP"],
  "spec": ["CMP-002", "CMP-004"],
  "setup": {
    "snapshot": "two-branch",
    "principal": {
      "subject": "user:approver",
      "tenant": "acme-corp",
      "scopes": ["tasks:decide"]
    }
  },
  "steps": [
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "gap_task",
            "arguments": {
              "action": "decide",
              "id": "task-1",
              "decision": "approve",
              "note": "approved by human"
            },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "resultType": "complete",
            "isError": false,
            "structuredContent": {
              "data": {
                "task": {
                  "id": "task-1",
                  "state": "COMPLETED"
                }
              }
            }
          }
        }
      }
    }
  ]
}
