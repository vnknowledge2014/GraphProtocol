{
  "name": "HTTP header validation enforces Mcp-Method and Mcp-Name against body and decodes Base64 sentinel",
  "class": ["Facade-MCP"],
  "spec": ["CMP-001"],
  "setup": {
    "snapshot": "two-branch",
    "principal": {
      "subject": "user:alice",
      "tenant": "acme-corp",
      "scopes": ["read:all"]
    }
  },
  "steps": [
    {
      "request": {
        "http": {
          "method": "POST",
          "path": "/mcp",
          "headers": {
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
            "mcp-protocol-version": "2026-07-28",
            "mcp-method": "tools/list"
          }
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "tools/call",
          "params": {
            "name": "gap_describe",
            "arguments": { "overview": true },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "error": {
            "code": -32020
          }
        }
      }
    },
    {
      "request": {
        "http": {
          "method": "POST",
          "path": "/mcp",
          "headers": {
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
            "mcp-protocol-version": "2026-07-28",
            "mcp-method": "tools/call",
            "mcp-name": "gap_search"
          }
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/call",
          "params": {
            "name": "gap_describe",
            "arguments": { "overview": true },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "error": {
            "code": -32020
          }
        }
      }
    },
    {
      "request": {
        "http": {
          "method": "POST",
          "path": "/mcp",
          "headers": {
            "content-type": "application/json",
            "accept": "application/json, text/event-stream",
            "mcp-protocol-version": "2026-07-28",
            "mcp-method": "tools/call",
            "mcp-name": "=?base64?Z2FwX2Rlc2NyaWJl?="
          }
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "tools/call",
          "params": {
            "name": "gap_describe",
            "arguments": { "overview": true },
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "jsonrpc": "2.0",
          "id": 3,
          "result": {
            "resultType": "complete",
            "isError": false
          }
        }
      }
    }
  ]
}
