{
  "name": "stateless 2026-07-28 stdio handles independent requests without initialize or session",
  "class": ["Facade-MCP"],
  "spec": ["CMP-001"],
  "setup": {
    "snapshot": "two-branch",
    "principal": {
      "subject": "user:alice",
      "tenant": "acme-corp",
      "scopes": ["read:all"]
    }
  },
  "steps": [
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": "s-1",
          "method": "server/discover",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": "s-1",
          "result": {
            "resultType": "complete",
            "supportedVersions": ["2026-07-28", "2025-11-25"]
          }
        }
      }
    },
    {
      "request": {
        "stdio": {
          "jsonrpc": "2.0",
          "id": "s-2",
          "method": "tools/list",
          "params": {
            "_meta": {
              "io.modelcontextprotocol/protocolVersion": "2026-07-28",
              "io.modelcontextprotocol/clientCapabilities": {}
            }
          }
        }
      },
      "expect": {
        "body": {
          "jsonrpc": "2.0",
          "id": "s-2",
          "result": {
            "resultType": "complete",
            "cacheScope": "public",
            "tools": [
              { "name": "gap_search" },
              { "name": "gap_describe" },
              { "name": "gap_query" },
              { "name": "gap_mutate" },
              { "name": "gap_task" }
            ]
          }
        }
      }
    }
  ]
}
