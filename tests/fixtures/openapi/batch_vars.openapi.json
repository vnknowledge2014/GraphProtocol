{
  "openapi": "3.1.0",
  "info": {
    "title": "Batch Shared Variables Fixture API",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "items",
        "summary": "Batch item lookup supporting shared fields projection",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "summary",
                "detail"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}": {
      "get": {
        "operationId": "item",
        "summary": "Single item lookup with optional fields projection",
        "x-gap-in-param": {
          "path": "/items",
          "param": "ids",
          "key_field": "id",
          "max_batch_size": 10
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "summary",
                "detail"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          },
          "404": {
            "description": "Item not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "stock": {
            "type": "integer"
          }
        }
      }
    }
  }
}
