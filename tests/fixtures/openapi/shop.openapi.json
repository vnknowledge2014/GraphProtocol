{
  "openapi": "3.1.0",
  "info": {
    "title": "GAP Shop Fixture API",
    "version": "0.1.0",
    "description": "Deterministic OpenAPI 3.1 fixture for gap-ngc-openapi v0 and NGC conformance."
  },
  "servers": [
    {
      "url": "https://api.shop.internal/v1",
      "description": "Untrusted document server URL; recorded in report and never followed."
    }
  ],
  "paths": {
    "/blobs": {
      "get": {
        "operationId": "blobs",
        "summary": "List binary-like text blobs for response-size truncation probes",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated blob list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Blob"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "get": {
        "operationId": "customers",
        "summary": "List customers with pagination, sort, region filter, and native id batching",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "-id",
                "name",
                "-name",
                "credit_cents",
                "-credit_cents"
              ]
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Region"
            }
          },
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Customer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "customer",
        "summary": "Fetch a single customer by numeric id",
        "x-gap-in-param": {
          "path": "/customers",
          "param": "ids",
          "key_field": "id",
          "max_batch_size": 50
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-Request-Tag",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "orders",
        "summary": "List orders with offset pagination and multi-status filter",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/OrderStatus"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_order",
        "summary": "Create order (skipped in v0: non-GET method)",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "order",
        "summary": "Fetch a single order by id (emulated foreach)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }
        }
      }
    },
    "/products/{sku}": {
      "get": {
        "operationId": "product",
        "summary": "Fetch a product by arbitrary string SKU",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/slow": {
      "get": {
        "operationId": "slow",
        "summary": "Never completes until the caller cancels or times out",
        "responses": {
          "200": {
            "description": "Unreachable ok payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SlowStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Blob": {
        "type": "object",
        "required": [
          "id",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "payload": {
            "type": "string"
          }
        }
      },
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "region",
          "credit_cents",
          "active"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "$ref": "#/components/schemas/Region"
          },
          "credit_cents": {
            "type": "integer"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "customer_id",
          "total_cents",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer_id": {
            "type": "integer"
          },
          "total_cents": {
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "pending",
          "paid",
          "shipped"
        ]
      },
      "Product": {
        "type": "object",
        "required": [
          "sku",
          "title",
          "price_cents",
          "tags"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Region": {
        "type": "string",
        "enum": [
          "eu",
          "us",
          "apac"
        ]
      },
      "SlowStatus": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
