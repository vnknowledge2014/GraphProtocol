{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders API Fixture",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://orders.example.com/v1" }
  ],
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "customer_id": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "Customer": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } },
                    "next_cursor": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
